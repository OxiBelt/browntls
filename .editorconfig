root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,toml}]
indent_size = 2

# Markdown prose and Rust comments wrap at 80 columns
# (tests/scripts/check_line_width.py); rustfmt keeps Rust code within 100.
[*.md]
max_line_length = 80

[*.rs]
max_line_length = 100
